{
  "name": "@envoydev/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "tauri:dev": "npm run daemon:build && tauri dev",
    "tauri:build": "node ../../scripts/stage-desktop-bundle.mjs && tauri build --config src-tauri/tauri.conf.bundle.json",
    "tauri:build:mac": "bash ../../scripts/build-dmg.sh",
    "tauri:build:win": "powershell -NoProfile -ExecutionPolicy Bypass -File ../../scripts/build-exe.ps1",
    "tauri:build:linux": "bash ../../scripts/build-linux.sh",
    "daemon:build": "node scripts/build-daemon.mjs",
    "daemon:package": "node scripts/build-daemon.mjs --package"
  },
  "dependencies": {
    "@envoydev/agent-catalog": "0.1.0",
    "@envoydev/host-bridge": "0.1.0",
    "@envoydev/platform": "0.1.0",
    "@envoydev/protocol": "0.1.0",
    "@envoydev/task-model": "0.1.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "highlight.js": "^11.12.0",
    "mermaid": "^12.0.0",
    "qrcode": "^1.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.1.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.1.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "^0.28.2",
    "jsdom": "^25.0.1",
    "vite": "^6.0.7"
  }
}
