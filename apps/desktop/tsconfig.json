{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist-types",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": false,
    "types": [
      "vite/client"
    ],
    "tsBuildInfoFile": "./dist-types/tsconfig.tsbuildinfo"
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx"
  ],
  "references": [
    {
      "path": "../../packages/protocol"
    },
    {
      "path": "../../packages/platform"
    },
    {
      "path": "../../packages/task-model"
    },
    {
      "path": "../../packages/agent-catalog"
    },
    {
      "path": "../../packages/host-bridge"
    }
  ]
}
